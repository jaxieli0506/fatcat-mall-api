{
  // 資料庫連線字串（預設使用本機 LocalDB）
  "ConnectionStrings": {
    "TeamDb2": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=TeamDb2;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // ⚠️ 以下敏感設定請勿直接寫在此檔，請改用 dotnet user-secrets 設定（見 README）

  // JWT 設定
  "Jwt": {
    "Key": "<至少 32 字元的隨機字串>",
    "Issuer": "FatCatApi",
    "Audience": "FatCatUsers",
    "ExpiryHours": 24
  },

  // 第三方登入設定
  "ExternalLogin": {
    "Facebook": {
      "AppId": "<FACEBOOK_APP_ID>",
      "AppSecret": "<FACEBOOK_APP_SECRET>"
    },
    "Google": {
      "ClientId": "<GOOGLE_CLIENT_ID>",
      "ClientSecret": "<GOOGLE_CLIENT_SECRET>"
    },
    "Line": {
      "ChannelId": "<LINE_CHANNEL_ID>",
      "ChannelSecret": "<LINE_CHANNEL_SECRET>"
    }
  },

  // SMTP 寄信設定（Gmail 需使用「應用程式密碼」）
  "SmtpSettings": {
    "Server": "smtp.gmail.com",
    "Port": 587,
    "SenderName": "Fat Cat 購物商城",
    "SenderEmail": "<SENDER_EMAIL>",
    "Password": "<GMAIL_APP_PASSWORD>",
    "EnableSsl": true
  },

  // AWS IVS 直播設定
  "IVS": {
    "IngestEndpoint": "<IVS_INGEST_ENDPOINT>",
    "StreamKey": "<IVS_STREAM_KEY>",
    "PlaybackUrl": "<IVS_PLAYBACK_URL>",
    "ChatRoomArn": "<IVS_CHAT_ROOM_ARN>"
  },
  "AWS": {
    "AccessKeyId": "<AWS_ACCESS_KEY_ID>",
    "SecretAccessKey": "<AWS_SECRET_ACCESS_KEY>",
    "Region": "ap-northeast-1"
  }
}
